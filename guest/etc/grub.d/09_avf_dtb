#!/bin/sh
set -e

prefix="/usr"
exec_prefix="/usr"
datarootdir="/usr/share"
. "$datarootdir/grub/grub-mkconfig_lib"

echo "insmod chain"
prepare_grub_to_access_device "${GRUB_DEVICE_BOOT}"
cat << 'EOF'
if [ -f /boot/avf-fdt-edge.efi ]; then
    if chainloader /boot/avf-fdt-edge.efi; then
        boot
    fi
fi
EOF
